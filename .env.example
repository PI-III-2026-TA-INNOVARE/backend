# referência .env para clone do repositório — copie e preencha os valores

SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

DB_NAME=
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Email Configuration
# Use 'django.core.mail.backends.console.EmailBackend' para testes (escreve no console)
# Use 'django.core.mail.backends.smtp.EmailBackend' para produção
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@pdconnect.com

# Frontend URL para links de redefinição de senha
FRONTEND_URL=http://localhost:5173

GEMINI_API_KEY=

# Busca semãntica (MiniLM)
SEARCH_EMBEDDING_DIMENSION=384
SEARCH_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
SEARCH_EMBEDDING_ALLOW_HASH_FALLBACK=True
SEARCH_MIN_HYBRID_SCORE=0.24
SEARCH_RELATIVE_CUTOFF=0.55

# Match por IA (versão apenas com pgvector e miniLM)
AI_MATCH_LIMIT_PER_RESEARCH=30
AI_MATCH_LIMIT_PER_RESEARCHER=30
AI_MATCH_MIN_SCORE=0.26
AI_MATCH_WEIGHT_SEMANTIC=0.45
AI_MATCH_WEIGHT_LEXICAL=0.20
AI_MATCH_WEIGHT_AREA=0.25
AI_MATCH_WEIGHT_AVAILABILITY=0.10
