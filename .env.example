# referência .env para clone do repositório — copie e preencha os valores

SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

DB_NAME=
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Busca semantica (MiniLM)
SEARCH_EMBEDDING_DIMENSION=384
SEARCH_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
SEARCH_EMBEDDING_ALLOW_HASH_FALLBACK=True
SEARCH_MIN_HYBRID_SCORE=0.28
SEARCH_RELATIVE_CUTOFF=0.65