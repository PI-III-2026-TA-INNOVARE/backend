# referência .env para clone do repositório — copie e preencha os valores

SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

DB_NAME=
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Email Configuration
# Use 'django.core.mail.backends.console.EmailBackend' para testes (escreve no console)
# Use 'django.core.mail.backends.smtp.EmailBackend' para produção
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@pdconnect.com

# Frontend URL para links de redefinição de senha
FRONTEND_URL=http://localhost:5173

GEMINI_API_KEY=